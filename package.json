{
  "name": "rebate-attack-force",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "maps:compile": "node --import tsx scripts/compile-maps.ts",
    "maps:paint": "node scripts/paint-maps.mjs && npm run maps:compile",
    "predev": "npm run maps:compile",
    "predev:client": "npm run maps:compile",
    "predev:server": "npm run maps:compile",
    "prebuild": "npm run maps:compile",
    "pretest": "npm run maps:compile",
    "dev": "concurrently -k -n game,rooms -c green,cyan \"vite --host 0.0.0.0\" \"tsx watch server/index.ts\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:bots": "node scripts/bots-smoke.mjs",
    "test:mines": "node scripts/mines-smoke.mjs",
    "test:maps": "node scripts/maps-smoke.mjs",
    "test:mobile": "node scripts/mobile-smoke.mjs",
    "test:audio": "node scripts/audio-smoke.mjs",
    "test:effects": "node scripts/effects-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test:visual": "node scripts/visual-review.mjs"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.0",
    "@colyseus/sdk": "^0.18.0",
    "@colyseus/ws-transport": "^0.18.0",
    "express": "^5.1.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "concurrently": "^9.2.0",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
